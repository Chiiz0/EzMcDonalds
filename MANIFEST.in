include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
recursive-include docs *.md
exclude docs/prototype-history.md
recursive-include examples *.json
recursive-exclude .private *
recursive-exclude .tools *
recursive-exclude downloads *
recursive-exclude analysis *
recursive-exclude artifacts *
recursive-exclude tests *
recursive-include tests test_project_*.py
# Research source is available in Git, not installed as a supported capability.
prune experiments
